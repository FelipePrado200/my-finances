# Database connection string
# Example for PostgreSQL: postgresql://user:password@localhost:5432/my_finances_db
DATABASE_URL=postgresql://user:password@localhost:5432/my_finances_db

# JWT secret for signing authentication tokens
# Generate a strong random string (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your_secret_key_here_minimum_32_characters

# Application environment
NODE_ENV=development
